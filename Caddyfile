# Caddyfile — automatic HTTPS via Let's Encrypt
# Template variables ${YOUR_DOMAIN} and ${CADDY_EMAIL} are rendered by deploy-droplet.sh via sed.
# Do NOT commit rendered values; keep as template.

{
    email ${CADDY_EMAIL}
}

${YOUR_DOMAIN} {

    # TikTok legal docs (required for Developer Platform review) — specific routes FIRST
    handle_path /privacy {
        reverse_proxy docs:80
    }

    handle_path /terms {
        reverse_proxy docs:80
    }

    handle_path /data-usage {
        reverse_proxy docs:80
    }

    handle_path /app-description {
        reverse_proxy docs:80
    }

    handle_path /logo.png {
        reverse_proxy docs:80
    }

    # n8n automation UI — catch-all LAST
    handle / {
        reverse_proxy n8n:5678 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Port {server_port}
        }
    }

    # Health check
    handle /healthz {
        reverse_proxy n8n:5678
    }
}
