# Caddyfile — automatic HTTPS via Let's Encrypt
# Template variables ${YOUR_DOMAIN} and ${CADDY_EMAIL} are rendered by deploy-droplet.sh via sed.
# Do NOT commit rendered values; keep as template.
#
# IMPORTANT: Deploy requires DOMAIN and CADDY_EMAIL env vars to be set before running deploy-droplet.sh
# If these are empty, the rendered config is invalid and Caddy will not start.

{
    email ${CADDY_EMAIL}
}

${YOUR_DOMAIN} {

    # TikTok legal docs — rewrite to the real .html file served by docs
    # (handle_path would strip the path and docs would serve index.html instead)
    handle /privacy {
        rewrite * /privacy.html
        reverse_proxy docs:80
    }

    handle /terms {
        rewrite * /terms.html
        reverse_proxy docs:80
    }

    handle /data-usage {
        rewrite * /data-usage.html
        reverse_proxy docs:80
    }

    handle /app-description {
        rewrite * /app-description.html
        reverse_proxy docs:80
    }

    handle /logo.png {
        reverse_proxy docs:80
    }

    handle /favicon.ico {
        reverse_proxy docs:80
    }

    handle /healthz {
        reverse_proxy n8n:5678
    }

    # n8n — bare handle is the catch-all (every other path: /assets, /rest, /webhook...)
    # `handle /` would match ONLY "/" and leave JS assets unanswered -> MIME errors.
    handle {
        # Caddy already sets X-Forwarded-For/-Proto/-Host; no header_up needed.
        reverse_proxy n8n:5678
    }
}
