# Copy to .env and fill in your values

# n8n
N8N_PASSWORD=your_secure_password_here

# Twitch API (create at https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_ACCESS_TOKEN=your_twitch_access_token
TWITCH_REFRESH_TOKEN=your_twitch_refresh_token

# Kick API (if available)
KICK_CLIENT_ID=your_kick_client_id
KICK_CLIENT_SECRET=your_kick_client_secret

# TikTok Developer (apply at https://developers.tiktok.com/)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_REFRESH_TOKEN=your_tiktok_refresh_token

# Google Sheets (for analytics)
GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account",...}
GOOGLE_SHEET_ID=your_sheet_id

# Discord webhook (for notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Storage (Cloudflare R2 / S3 compatible)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=tiktok-clips
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# OpenAI (optional, for better transcription)
OPENAI_API_KEY=sk-...

# Whisper model (local transcription)
WHISPER_MODEL=/models/ggml-base.en.bin

# Streamer list (comma-separated Twitch usernames)
STREAMER_LIST=streamer1,streamer2,streamer3

# Games to focus on (comma-separated)
GAME_LIST=Valorant,League of Legends,Counter-Strike 2