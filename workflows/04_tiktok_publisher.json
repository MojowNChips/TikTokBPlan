{
  "id": "tkc04TiktokPublisher",
  "name": "04 - TikTok Publisher",
  "active": false,
  "nodes": [
    {
      "name": "Post Schedule (11am, 3pm, 7pm, 10pm)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 11,15,19,22 * * *"
            }
          ]
        }
      },
      "id": "17242a2e-c43e-5141-8961-6607bf18fe0d"
    },
    {
      "name": "Read Ready Clips",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        300
      ],
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GOOGLE_SHEET_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Ready_Clips"
        },
        "options": {}
      },
      "id": "84667263-e8b7-5666-829d-fb6a1f997688"
    },
    {
      "name": "Find Next Unposted Clip",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "// First row with status ready_to_post; no output (workflow stops quietly) when there is none.\nconst row = $input.all().map(i => i.json).find(r => r.status === 'ready_to_post');\nreturn row ? [{ json: row }] : [];\n"
      },
      "id": "1f2cd6a7-0710-5a8d-9dfa-8f6d605e3a92"
    },
    {
      "name": "Generate Caption & Hashtags",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "const { streamer = '', game = '', title = '', reason = '', file_size_mb } = $json;\nconst pillarHashtags = {\n  'Insane Plays': '#clutch #outplay #insane #gamingclips #proplay',\n  'Funny Moments': '#funny #fail #ragemoment #gamingfunny #lol',\n  'Reactions': '#reaction #streamer #gamingreaction #priceless',\n  'Tips': '#gamingtips #howto #protip #improve #guide',\n};\nlet pillar = 'Insane Plays';\nconst text = `${title} ${reason}`.toLowerCase();\nif (/funny|fail|lol/.test(text)) pillar = 'Funny Moments';\nelse if (/react|wtf|omg/.test(text)) pillar = 'Reactions';\nelse if (/tip|how|guide/.test(text)) pillar = 'Tips';\n\nconst caption = `${title}\\n\\n${reason}\\n\\nStreamer: @${streamer}\\nGame: ${game}\\n\\n${pillarHashtags[pillar]} #${String(game).replace(/\\s+/g, '')} #${streamer} #fyp #gaming`;\nconst file_size_bytes = Math.round(Number(file_size_mb || 0) * 1024 * 1024);\n// TikTok: a file under 64 MB may be sent as a single chunk.\nreturn { ...$json, caption, pillar, file_size_bytes, chunk_size: file_size_bytes, total_chunk_count: 1 };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "ef9b068c-0b32-53cc-83c7-64d25f36de8f"
    },
    {
      "name": "TikTok Init Upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/post/publish/video/init/",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.TIKTOK_ACCESS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ post_info: { title: $json.caption, privacy_level: ($env.TIKTOK_PRIVACY_LEVEL || 'PUBLIC_TO_EVERYONE'), disable_duet: false, disable_stitch: false, disable_comment: false }, source_info: { source: 'FILE_UPLOAD', video_size: $json.file_size_bytes, chunk_size: $json.chunk_size, total_chunk_count: $json.total_chunk_count } }) }}"
      },
      "id": "f0f85e0f-13a9-5b09-bd64-4b5af0921885"
    },
    {
      "name": "Prepare Video Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "// Merge TikTok's publish_id / upload_url with the clip; make sure the video file exists.\nconst fs = require('fs');\nconst clip = $('Generate Caption & Hashtags').item.json;\nconst { publish_id, upload_url } = $json.data || {};\nif (!publish_id || !upload_url) throw new Error('TikTok init failed: ' + JSON.stringify($json.error || $json));\nif (!fs.existsSync(clip.video_path)) throw new Error('Video file not found: ' + clip.video_path);\nreturn { ...clip, publish_id, upload_url, file_size_bytes: fs.statSync(clip.video_path).size };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "edcddac5-0d8d-59db-812e-43768dabfac0"
    },
    {
      "name": "Upload Video to TikTok",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "executeOnce": false,
        "command": "=python3 /scripts/upload_tiktok.py \"{{ $json.video_path }}\" \"{{ $json.upload_url }}\" \"{{ $json.publish_id }}\""
      },
      "id": "0c0f5b4c-daea-5e51-8e28-78b0e0160cf9"
    },
    {
      "name": "Check Publish Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/post/publish/status/fetch/",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.TIKTOK_ACCESS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ publish_id: $('Prepare Video Upload').item.json.publish_id }) }}"
      },
      "id": "cf4ab37e-80d7-5961-bf54-7200a2c58b6f"
    },
    {
      "name": "Mark Clip as Posted",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1760,
        140
      ],
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GOOGLE_SHEET_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Ready_Clips"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "clip_id": "={{ $('Prepare Video Upload').item.json.clip_id }}",
            "status": "posted",
            "posted_at": "={{ $now.toISO() }}"
          },
          "matchingColumns": [
            "clip_id"
          ],
          "schema": []
        },
        "options": {
          "cellFormat": "USER_ENTERED"
        }
      },
      "id": "4817d970-df2e-51e1-b3bc-b7682306b4ec"
    },
    {
      "name": "Log to Analytics",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GOOGLE_SHEET_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Analytics"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "posted_at": "={{ $now.toISO() }}",
            "clip_id": "={{ $('Prepare Video Upload').item.json.clip_id }}",
            "streamer": "={{ $('Prepare Video Upload').item.json.streamer }}",
            "game": "={{ $('Prepare Video Upload').item.json.game }}",
            "pillar": "={{ $('Prepare Video Upload').item.json.pillar }}",
            "publish_id": "={{ $('Prepare Video Upload').item.json.publish_id }}",
            "status": "posted",
            "views": "0"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {
          "cellFormat": "USER_ENTERED"
        }
      },
      "id": "9cafcd52-0a1d-5533-a434-c4a897340e8b"
    },
    {
      "name": "Send Posted Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        460
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ username: 'Clip Bot', content: `✅ **Posted to TikTok**\\n**Clip:** ${$('Prepare Video Upload').item.json.clip_id}\\n**Streamer:** ${$('Prepare Video Upload').item.json.streamer}\\n**Game:** ${$('Prepare Video Upload').item.json.game}\\n**Pillar:** ${$('Prepare Video Upload').item.json.pillar}\\n**Caption:** ${String($('Prepare Video Upload').item.json.caption).substring(0, 100)}...\\n**Link:** ${$('Prepare Video Upload').item.json.video_url}` }) }}"
      },
      "id": "3fb31f09-edde-5132-9935-21f8604e6878"
    }
  ],
