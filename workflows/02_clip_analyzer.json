        "path": "analyze-vod",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "b9b0bee1-07a2-5744-9166-beaaac1b7fc7"
    },
    {
      "name": "When Called by 01",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        420
      ],
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "91949932-a370-57be-a9ee-0850ae56ab53"
    },
    {
      "name": "Prepare VOD Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// The webhook puts the POSTed JSON under `body`.\nconst vod = $json.body || $json;\nreturn {\n  vod_id: String(vod.vod_id || ''), streamer: vod.streamer, title: vod.title, game: vod.game,\n  duration: vod.duration, url: vod.url, created_at: vod.created_at, view_count: vod.view_count,\n};\n",
        "mode": "runOnceForEachItem"
      },
      "id": "0b7d56fe-ece8-5f84-b8ba-4c01127f8a6e"
    },
    {
      "name": "Prepare Analysis Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "// Runs scripts/analyze_vod.py (yt-dlp + whisper + scoring); it must print a JSON array of clips.\nconst safe = s => String(s || '').replace(/[^A-Za-z0-9_\\-]/g, '');\nreturn { ...$json, command: `python3 /scripts/analyze_vod.py \"${safe($json.vod_id)}\" \"${safe($json.streamer)}\"` };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "22d4c54f-ae18-5a0c-a995-1d5e19fe365c"
    },
    {
      "name": "Run VOD Analyzer Script",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        660,
        300
      ],
      "parameters": {
        "executeOnce": false,
        "command": "={{ $json.command }}"
      },
      "id": "082239de-9c39-532e-aafd-96766b34c2d6"
    },
    {
      "name": "Parse & Filter Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "jsCode": "// Parse analyzer stdout, keep the best clips (score >= CLIP_SCORE_THRESHOLD, at most\n// MAX_CLIPS_PER_VOD per VOD) and shape them as Clip_Queue rows.\nconst THRESHOLD = Number($env.CLIP_SCORE_THRESHOLD || 60);\nconst MAX_PER_VOD = Number($env.MAX_CLIPS_PER_VOD || 3);\nconst out = [];\n$input.all().forEach((item, i) => {\n  const vod = $('Prepare Analysis Command').itemMatching(i).json;\n  let clips;\n  try { clips = JSON.parse(item.json.stdout || '[]'); }\n  catch (e) { throw new Error(`Analyzer output for VOD ${vod.vod_id} is not valid JSON: ${e.message}\\n${item.json.stderr || ''}`); }\n  if (!Array.isArray(clips)) throw new Error(`Analyzer failed for VOD ${vod.vod_id}: ${JSON.stringify(clips)}\\n${item.json.stderr || ''}`);\n  const best = clips.filter(c => c && c.score >= THRESHOLD).sort((a, b) => b.score - a.score).slice(0, MAX_PER_VOD);\n  for (const c of best) {\n    out.push({ json: {\n      clip_id: c.clip_id || `clip_${vod.vod_id}_${c.start_time}`,\n      vod_id: vod.vod_id, streamer: vod.streamer, game: c.game || vod.game || '',\n      start_time: c.start_time, end_time: c.end_time, title: c.title || vod.title || '',\n      reason: c.reason || '', score: c.score, status: 'processing',\n      review_url: `${vod.url || ''}?t=${Math.floor(c.start_time / 3600)}h${Math.floor((c.start_time % 3600) / 60)}m${Math.floor(c.start_time % 60)}s`,\n      vod_url: vod.url || `https://www.twitch.tv/videos/${vod.vod_id}`, created_at: new Date().toISOString(),\n    }});\n  }\n});\nreturn out;\n"
      },
      "id": "f30ba084-a525-5ca5-b1dd-8f10fe74f11b"
    },
    {
      "name": "Queue Approved Clips",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1100,
        120
      ],
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GOOGLE_SHEET_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Clip_Queue"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {
          "cellFormat": "USER_ENTERED",
          "handlingExtraData": "ignoreIt"
        }
      },
      "id": "6a2edc9e-4540-5754-9076-4750cd85bc9e"
    },
    {
      "name": "Render Each Clip (03)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
