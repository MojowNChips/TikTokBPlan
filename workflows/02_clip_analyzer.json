          "waitForSubWorkflow": true
        }
      },
      "id": "694b8af3-1eb4-5bfe-9b3b-fbfbdc4aeb10"
    },
    {
      "name": "Format Discord Notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        420
      ],
      "parameters": {
        "jsCode": "// One Discord message per approved clip.\nreturn $input.all().map(({ json: c }) => ({ json: {\n  username: 'Clip Bot',\n  content: `🎬 **Clip found, rendering now**\\n**Streamer:** ${c.streamer}\\n**Game:** ${c.game}\\n**Score:** ${c.score}/100\\n**Moment:** ${c.start_time}s - ${c.end_time}s\\n**Reason:** ${c.reason}\\n\\nReview: ${c.review_url}`,\n}}));\n"
      },
      "id": "28465961-0cfc-5744-b13b-430cf5c377fe"
    },
    {
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        420
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.content, username: $json.username }) }}"
      },
      "id": "0e54ef4d-7cd6-51c1-97d1-bf72234dd411"
    }
  ],
